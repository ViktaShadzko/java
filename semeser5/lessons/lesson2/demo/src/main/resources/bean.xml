<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="scenarioService" class="org.example.service.ScenarioService"/>

    <beans profile="LightCruiser">
        <bean id="lazerGun1" class="org.example.entity.Gun">
            <constructor-arg value="Pew" name="shootSound"/>
            <constructor-arg value="10"/>
            <constructor-arg value="100"/>
            <constructor-arg value="2"/>
        </bean>

        <bean id="lazerGun2" class="org.example.entity.Gun">
            <constructor-arg value="Pew"/>
            <constructor-arg value="10"/>
            <constructor-arg value="100"/>
            <constructor-arg value="2"/>
        </bean>

        <bean id="shieldGenerator" class="org.example.entity.ShieldGenerator">
            <constructor-arg value="150"/>
            <constructor-arg value="5"/>
        </bean>

        <bean id="engine" class="org.example.entity.Engine">
            <constructor-arg value="300"/>
            <constructor-arg value="5"/>
        </bean>

        <bean id="spaceShip" class="org.example.entity.SpaceShip">
            <constructor-arg>
                <list>
                    <ref bean="lazerGun1"/>
                    <ref bean="lazerGun2"/>
                </list>
            </constructor-arg>
            <constructor-arg ref="shieldGenerator"/>
            <constructor-arg ref="engine"/>
        </bean>
    </beans>

    <beans profile="HeavyCruiser">
        <bean id="rocketLauncher" class="org.example.entity.Gun">
            <constructor-arg value="Boom"/>
            <constructor-arg value="50"/>
            <constructor-arg value="300"/>
            <constructor-arg value="5"/>
        </bean>

        <bean id="kineticGun" class="org.example.entity.Gun">
            <constructor-arg value="Bang"/>
            <constructor-arg value="20"/>
            <constructor-arg value="150"/>
            <constructor-arg value="3"/>
        </bean>

        <bean id="heavyShieldGenerator" class="org.example.entity.ShieldGenerator">
            <constructor-arg value="400"/>
            <constructor-arg value="10"/>
        </bean>

        <bean id="heavyEngine" class="org.example.entity.Engine">
            <constructor-arg value="600"/>
            <constructor-arg value="12"/>
        </bean>

        <bean id="spaceShip" class="org.example.entity.SpaceShip">
            <constructor-arg>
                <list>
                    <ref bean="rocketLauncher"/>
                    <ref bean="kineticGun"/>
                </list>
            </constructor-arg>
            <constructor-arg ref="heavyShieldGenerator"/>
            <constructor-arg ref="heavyEngine"/>
        </bean>
    </beans>
</beans>
